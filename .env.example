# Required for local PostgreSQL and Prisma.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/b2b_ar_collections?schema=public"

# Required by the Stage 5 release gate in hosted environments.
DEPLOYMENT_ENVIRONMENT="staging"

# Required for application-level AES-256-GCM encryption of Shopify tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_ENCRYPTION_KEY=""
SESSION_ENCRYPTION_KEY_ID="primary"

# Required in production so deletion tombstones remain independently
# non-reversible and can be replayed after a backup restore.
PRIVACY_TOMBSTONE_KEY=""

# Populated by `shopify app dev` or `shopify app env pull` after linking.
SHOPIFY_API_KEY=""
SHOPIFY_API_SECRET=""
SHOPIFY_APP_URL="http://localhost:3000"
SCOPES="read_orders,read_all_orders,read_payment_terms,read_customers"

# D6 Shopify App Pricing. The Partner client needs only Manage apps.
SHOPIFY_PARTNER_ORGANIZATION_ID=""
SHOPIFY_PARTNER_ACCESS_TOKEN=""
SHOPIFY_PARTNER_APP_GID=""
SHOPIFY_APP_HANDLE=""
SHOPIFY_PLAN_HANDLE_FREE="free"
SHOPIFY_PLAN_HANDLE_STARTER="starter"
SHOPIFY_PLAN_HANDLE_GROWTH="growth"
SHOPIFY_PLAN_HANDLE_SCALE="scale"
SHOPIFY_PLAN_HANDLE_TEST="private-test"

# D5 transactional email. Keep production and non-production Postmark streams separate.
POSTMARK_SERVER_TOKEN=""
POSTMARK_FROM_EMAIL=""
POSTMARK_MESSAGE_STREAM="b2b-ar-staging"
# Configure this as an `x-postmark-webhook-token` custom webhook header.
POSTMARK_WEBHOOK_TOKEN=""

# Optional local server configuration.
PORT="3000"
NODE_ENV="development"
RELEASE_VERSION="development"

# Worker shutdown is graceful; pg-boss owns its tables under the `pgboss` schema.
